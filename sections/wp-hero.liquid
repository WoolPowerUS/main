<div class="wp wp-hero wp--case-{{ section.settings.style_heading_case }} wp--align-{{ section.settings.style_align }} wp--width-{{ section.settings.style_width }} wp--size-{{ section.settings.style_heading_size }} wp--btn-{{ section.settings.style_button_look }} wp--btn-{{ section.settings.style_button_shape }} wp--btn-{{ section.settings.style_button_size }} wp--btn-case-{{ section.settings.style_button_case }}" id="wp-{{ section.id }}" style="--wp-section-bg: {{ section.settings.background_color }}; --wp-pt: {{ section.settings.padding_top }}px; --wp-pb: {{ section.settings.padding_bottom }}px; --wp-radius: {{ section.settings.style_radius }}px;{%- if section.settings.style_heading_color != blank %} --wp-heading-user: {{ section.settings.style_heading_color }};{%- endif -%}{%- if section.settings.style_text_color != blank %} --wp-text: {{ section.settings.style_text_color }}; --wp-text-user: {{ section.settings.style_text_color }};{%- endif -%}{%- if section.settings.style_accent_color != blank %} --wp-cta: {{ section.settings.style_accent_color }};{%- endif -%}{%- if section.settings.style_button_text_color != blank %} --wp-cta-text: {{ section.settings.style_button_text_color }};{%- endif -%}{%- if section.settings.style_card_color != blank %} --wp-card: {{ section.settings.style_card_color }}; --wp-card-user: {{ section.settings.style_card_color }};{%- endif -%}">
  {%- liquid
    assign hero_pos = section.settings.content_position
    case hero_pos
      when 'center'
        assign hero_h = 'center'
      when 'top-left', 'center-left', 'bottom-left'
        assign hero_h = 'left'
      when 'top-right', 'center-right', 'bottom-right'
        assign hero_h = 'right'
      else
        assign hero_h = 'center'
    endcase
  -%}
  <div class="wp__inner wp__inner--wide{% if section.settings.full_width %} wp-hero__bleed{% endif %}">
    <div class="wp-hero__card wp-hero--{{ section.settings.height }} wp-hero--{{ hero_pos }} wp-hero--h-{{ hero_h }}" style="--wp-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
      <div class="wp-hero__media">
        {%- if section.settings.image != blank -%}
          {%- if section.settings.image_mobile != blank -%}
            {{ section.settings.image_mobile | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'wp-hero__img wp-hero__img--mobile', sizes: '100vw', widths: '600, 900, 1200', alt: section.settings.image_mobile.alt }}
          {%- endif -%}
          {%- liquid
            assign hero_class = 'wp-hero__img'
            if section.settings.image_mobile != blank
              assign hero_class = 'wp-hero__img wp-hero__img--desktop'
            endif
          -%}
          {{ section.settings.image | image_url: width: 2800 | image_tag: loading: 'eager', fetchpriority: 'high', class: hero_class, sizes: '100vw', widths: '750, 1100, 1500, 2000, 2800', alt: section.settings.image.alt }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'wp-hero__img placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="wp-hero__content">
        {%- if section.settings.eyebrow != blank -%}<span class="wp-eyebrow" style="--wp-eyebrow: {{ section.settings.eyebrow_color }}">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h1 class="wp-hero__heading">{{ section.settings.heading }}</h1>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="wp-hero__text">{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <div class="wp-hero__buttons">
            {%- for block in section.blocks -%}
              <a class="wp-btn wp-btn--{{ block.settings.style }}" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      {%- if section.settings.show_card and section.settings.card_title != blank -%}
        <a class="wp-hero__float" href="{{ section.settings.card_link | default: '#layer-finder' }}">
          <span class="wp-hero__float-icon"><svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M5 6l7 4 7-4M5 18l7-4 7 4"></path></svg></span>
          <span><strong>{{ section.settings.card_title }}</strong>{%- if section.settings.card_text != blank -%}<span>{{ section.settings.card_text }}</span>{%- endif -%}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.wp-hero__card { position: relative; display: flex; min-height: var(--wp-hero-h, 640px); border-radius: var(--wp-radius); overflow: hidden; background: #2E3531; }
.wp-hero--small { --wp-hero-h: 440px; }
.wp-hero--medium { --wp-hero-h: 560px; }
.wp-hero--large { --wp-hero-h: 680px; }
.wp-hero--full { --wp-hero-h: calc(100svh - 140px); }
.wp-hero__bleed { max-width: none; padding-inline: 0; }
.wp-hero__bleed .wp-hero__card { border-radius: 0; }
.wp-hero--top-left, .wp-hero--top-center, .wp-hero--top-right { align-items: flex-start; }
.wp-hero--center-left, .wp-hero--center, .wp-hero--center-right { align-items: center; }
.wp-hero--bottom-left, .wp-hero--bottom-center, .wp-hero--bottom-right { align-items: flex-end; }
.wp-hero--h-left { justify-content: flex-start; }
.wp-hero--h-center { justify-content: center; text-align: center; }
.wp-hero--h-right { justify-content: flex-end; text-align: right; }
.wp-hero--h-center .wp-hero__content { align-items: center; }
.wp-hero--h-right .wp-hero__content { align-items: flex-end; }
.wp-hero--h-center .wp-hero__buttons { justify-content: center; }
.wp-hero--h-right .wp-hero__buttons { justify-content: flex-end; }
.wp-hero--h-right .wp-hero__float { right: auto; left: 24px; }
.wp-hero__media { position: absolute; inset: 0; }
.wp-hero__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(20,26,24,var(--wp-overlay)) 0%, rgba(20,26,24,calc(var(--wp-overlay) * 0.4)) 60%, rgba(20,26,24,0) 100%); }
.wp-hero--h-center .wp-hero__media::after { background: rgba(20,26,24,var(--wp-overlay)); }
.wp-hero--h-right .wp-hero__media::after { background: linear-gradient(270deg, rgba(20,26,24,var(--wp-overlay)) 0%, rgba(20,26,24,calc(var(--wp-overlay) * 0.4)) 60%, rgba(20,26,24,0) 100%); }
.wp-hero__img { width: 100%; height: 100%; object-fit: cover; display: block; }
.wp-hero__img--mobile { display: none; }
.wp-hero__content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; padding: 56px; max-width: 760px; }
.wp-hero__heading { margin: 0; font-family: var(--font-heading--family, inherit); font-weight: 800; font-size: calc(clamp(40px, 6vw, 80px) * var(--wp-hs, 1)); line-height: 1; text-transform: uppercase; color: var(--wp-heading-user, #FFFFFF); }
.wp-hero__text { margin: 0; font-size: 18px; color: var(--wp-text-user, #F0F4F6); max-width: 480px; }
.wp-hero__buttons { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
.wp-hero__float { position: absolute; right: 24px; bottom: 24px; z-index: 1; display: flex; align-items: center; gap: 16px; max-width: 320px; padding: 18px 20px; border-radius: var(--wp-radius); background: var(--wp-card); color: var(--wp-ink); text-decoration: none; text-align: left; box-shadow: 0 8px 24px rgba(31,45,64,0.18); }
.wp-hero__float strong { display: block; font-size: 14px; }
.wp-hero__float span span { display: block; font-size: 13px; color: var(--wp-text); }
.wp-hero__float-icon { flex: none; width: 44px; height: 44px; border-radius: 999px; background: var(--wp-bg); display: flex; align-items: center; justify-content: center; color: var(--wp-forest); }
@media (max-width: 749px) {
  .wp-hero__card, .wp-hero__card[class*="wp-hero--h-"] { min-height: min(var(--wp-hero-h, 640px), 560px); flex-direction: column; justify-content: flex-end; align-items: stretch; }
  .wp-hero__card.wp-hero--top-left, .wp-hero__card.wp-hero--top-center, .wp-hero__card.wp-hero--top-right { justify-content: flex-start; }
  .wp-hero__card.wp-hero--center-left, .wp-hero__card.wp-hero--center, .wp-hero__card.wp-hero--center-right { justify-content: center; }
  .wp-hero--h-right .wp-hero__float { left: auto; }
  .wp-hero__img--mobile { display: block; }
  .wp-hero__img--desktop { display: none; }
  .wp-hero__card .wp-hero__media::after { background: linear-gradient(0deg, rgba(20,26,24,var(--wp-overlay)) 0%, rgba(20,26,24,calc(var(--wp-overlay) * 0.3)) 70%); }
  .wp-hero__content { padding: 28px 20px; }
  .wp-hero__float { position: relative; right: auto; bottom: auto; margin: 0 12px 12px; max-width: none; }
  .wp-hero__buttons .wp-btn { flex: 1 1 auto; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "WP Hero",
  "class": "wp-section",
  "settings": [
    {
