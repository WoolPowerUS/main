          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "style_radius",
      "label": "Corner rounding",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "style_width",
      "label": "Width",
      "options": [
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "contained"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "select",
      "id": "style_button_look",
      "label": "Button style",
      "options": [
        {
          "value": "default",
          "label": "As set on each button"
        },
        {
          "value": "filled",
          "label": "Filled with accent color"
        },
        {
          "value": "outline",
          "label": "Outline in accent color"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "style_button_shape",
      "label": "Button shape",
      "options": [
        {
          "value": "pill",
          "label": "Pill"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "pill"
    },
    {
      "type": "select",
      "id": "style_button_size",
      "label": "Button size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "style_button_case",
      "label": "Button letters",
      "options": [
        {
          "value": "upper",
          "label": "ALL CAPS"
        },
        {
          "value": "normal",
          "label": "Normal"
        }
      ],
      "default": "upper"
    },
    {
      "type": "header",
      "content": "Spacing"
