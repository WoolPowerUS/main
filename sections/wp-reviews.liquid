      "id": "heading",
      "label": "Heading",
      "default": "What people say after a winter in it"
    },
    {
      "type": "text",
      "id": "summary",
      "label": "Rating summary",
      "info": "For example: 4.8 from 1,200 reviews"
    },
    {
      "type": "header",
      "content": "Look"
    },
    {
      "type": "paragraph",
      "content": "Leave a color empty to use the Woolpower default."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "style_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "style_text_color",
      "label": "Text color"
    },
    {
      "type": "color",
