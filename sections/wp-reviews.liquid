      "label": "Button and accent color"
    },
    {
      "type": "color",
      "id": "style_button_text_color",
      "label": "Button text color"
    },
    {
      "type": "color",
      "id": "style_card_color",
      "label": "Card and tile color"
    },
    {
      "type": "select",
      "id": "style_heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xlarge",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "style_heading_case",
      "label": "Heading letters",
      "options": [
        {
          "value": "upper",
          "label": "ALL CAPS"
        },
        {
          "value": "normal",
          "label": "Normal"
        }
      ],
