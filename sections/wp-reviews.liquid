          "id": "rating",
          "label": "Stars",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "[Customer review quote]"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "[Name]"
        },
        {
          "type": "text",
          "id": "detail",
