<div class="wp wp-quotes" id="wp-{{ section.id }}" style="--wp-section-bg: {{ section.settings.background_color }}; --wp-pt: {{ section.settings.padding_top }}px; --wp-pb: {{ section.settings.padding_bottom }}px;">
  <div class="wp__inner">
    <div class="wp-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="wp-eyebrow" style="color: var(--wp-forest)">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="wp-h2 wp-h2--lg" style="margin-top: 8px">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.summary != blank -%}<span style="font-size: 14px">{{ section.settings.summary }}</span>{%- endif -%}
    </div>
    <div class="wp-quotes__grid">
      {%- for block in section.blocks -%}
        <figure class="wp-quotes__item" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <span class="wp-quotes__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..block.settings.rating) %}★{% endfor %}</span>
          {%- endif -%}
          <blockquote>{{ block.settings.quote }}</blockquote>
          <figcaption>{{ block.settings.author }}{% if block.settings.detail != blank %}, {{ block.settings.detail }}{% endif %}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.wp-quotes__grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
@media (max-width: 749px) { .wp-quotes__grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: -16px; padding-inline: 16px; } .wp-quotes__item { flex: 0 0 85%; scroll-snap-align: start; } }
.wp-quotes__item { margin: 0; display: flex; flex-direction: column; gap: 14px; padding: 28px; border-radius: var(--wp-radius); background: var(--wp-quote-bg, var(--wp-bg)); }
.wp-quotes__stars { color: var(--wp-cta); letter-spacing: 2px; }
.wp-quotes__item blockquote { margin: 0; font-size: 16px; color: var(--wp-ink); }
.wp-quotes__item figcaption { font-size: 13px; }
{% endstylesheet %}

{% schema %}
{
  "name": "WP Reviews",
  "class": "wp-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Trusted where it's coldest"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What people say after a winter in it"
    },
    {
      "type": "text",
      "id": "summary",
      "label": "Rating summary",
      "info": "For example: 4.8 from 1,200 reviews"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "[Customer review quote]"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "[Name]"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "info": "For example: lineman, Montana"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "WP Reviews",
      "blocks": [
        {
          "type": "quote"
        },
        {
          "type": "quote"
        },
        {
          "type": "quote"
        }
      ]
    }
  ]
}
{% endschema %}
