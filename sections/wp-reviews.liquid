          "info": "For example: lineman, Montana"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "WP Reviews",
      "blocks": [
        {
          "type": "quote"
        },
        {
          "type": "quote"
        },
        {
          "type": "quote"
        }
      ]
    }
  ]
}
