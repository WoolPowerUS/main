<div class="wp wp-finder wp--case-{{ section.settings.style_heading_case }} wp--align-{{ section.settings.style_align }} wp--width-{{ section.settings.style_width }} wp--size-{{ section.settings.style_heading_size }} wp--btn-{{ section.settings.style_button_look }} wp--btn-{{ section.settings.style_button_shape }} wp--btn-{{ section.settings.style_button_size }} wp--btn-case-{{ section.settings.style_button_case }}" id="wp-{{ section.id }}" style="--wp-section-bg: {{ section.settings.background_color }}; --wp-pt: {{ section.settings.padding_top }}px; --wp-pb: {{ section.settings.padding_bottom }}px; --wp-radius: {{ section.settings.style_radius }}px;{%- if section.settings.style_heading_color != blank %} --wp-heading-user: {{ section.settings.style_heading_color }};{%- endif -%}{%- if section.settings.style_text_color != blank %} --wp-text: {{ section.settings.style_text_color }}; --wp-text-user: {{ section.settings.style_text_color }};{%- endif -%}{%- if section.settings.style_accent_color != blank %} --wp-cta: {{ section.settings.style_accent_color }};{%- endif -%}{%- if section.settings.style_button_text_color != blank %} --wp-cta-text: {{ section.settings.style_button_text_color }};{%- endif -%}{%- if section.settings.style_card_color != blank %} --wp-card: {{ section.settings.style_card_color }}; --wp-card-user: {{ section.settings.style_card_color }};{%- endif -%}">
  <div class="wp__inner wp__inner--wide">
    <wp-finder id="layer-finder" class="wp-finder__card" data-act="{{ section.settings.default_activity }}" data-temp="{{ section.settings.default_temp }}">
      <div class="wp-finder__q">
        <div>
          {%- if section.settings.eyebrow != blank -%}<span class="wp-eyebrow" style="color: var(--wp-forest)">{{ section.settings.eyebrow }}</span>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="wp-h2 wp-h2--lg" style="margin-top: 8px">{{ section.settings.heading }}</h2>{%- endif -%}
        </div>
        <fieldset class="wp-finder__group">
          <legend>{{ section.settings.q1 }}</legend>
          <div class="wp-finder__opts">
            {%- for i in (1..3) -%}
              {%- capture key -%}activity_{{ i }}{%- endcapture -%}
              {%- if section.settings[key] != blank -%}
                <button type="button" class="wp-pill" data-q="act" data-v="{{ i }}" aria-pressed="false">{{ section.settings[key] }}</button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </fieldset>
        <fieldset class="wp-finder__group">
          <legend>{{ section.settings.q2 }}</legend>
          <div class="wp-finder__opts">
            {%- for i in (1..3) -%}
              {%- capture key -%}temp_{{ i }}{%- endcapture -%}
              {%- if section.settings[key] != blank -%}
                <button type="button" class="wp-pill" data-q="temp" data-v="{{ i }}" aria-pressed="false">{{ section.settings[key] }}</button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </fieldset>
      </div>
      <div class="wp-finder__a" aria-live="polite">
        {%- for block in section.blocks -%}
          <div class="wp-finder__rec" data-act="{{ block.settings.activity }}" data-temp="{{ block.settings.temperature }}" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
            <span class="wp-media wp-finder__img">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 400', sizes: '160px', alt: '' }}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <div class="wp-finder__body">
              <span class="wp-eyebrow" style="color: var(--wp-yellow)">{{ section.settings.result_label }}</span>
              <span class="wp-finder__title">{{ block.settings.title }}</span>
              {%- if block.settings.text != blank -%}<span class="wp-finder__text">{{ block.settings.text }}</span>{%- endif -%}
              {%- if block.settings.button_label != blank -%}<a class="wp-btn wp-btn--primary" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label }}</a>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </wp-finder>
  </div>
</div>

{% stylesheet %}
.wp-finder__card { display: flex; flex-wrap: wrap; overflow: hidden; border-radius: var(--wp-radius); background: var(--wp-card); scroll-margin-top: 100px; }
.wp-finder__q { flex: 1 1 520px; padding: 56px; display: flex; flex-direction: column; gap: 28px; }
.wp-finder__group { border: 0; margin: 0; padding: 0; }
.wp-finder__group legend { padding: 0; margin-bottom: 12px; font-size: 14px; font-weight: 700; color: var(--wp-ink); }
.wp-finder__opts { display: flex; flex-wrap: wrap; gap: 8px; }
.wp-finder__a { flex: 1 1 420px; display: flex; align-items: center; padding: 56px; background: var(--wp-forest); color: #F0F4F6; }
.wp-finder__rec { display: flex; flex-wrap: wrap; align-items: center; gap: 28px; width: 100%; }
.wp-finder__rec[hidden] { display: none; }
.wp-finder__img { flex: none; width: 160px; aspect-ratio: 4 / 5; border-radius: 10px; }
.wp-finder__body { flex: 1 1 200px; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
.wp-finder__title { font-size: 30px; font-weight: 800; line-height: 1.1; color: #FFFFFF; text-transform: uppercase; }
.wp-finder__text { font-size: 15px; }
.wp-finder__body .wp-btn { margin-top: 8px; }
@media (max-width: 749px) {
  .wp-finder__q, .wp-finder__a { padding: 28px 20px; }
  .wp-finder__img { width: 112px; }
  .wp-finder__title { font-size: 24px; }
}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('wp-finder')) {
  customElements.define('wp-finder', class extends HTMLElement {
    connectedCallback() {
      this.state = { act: this.dataset.act || '1', temp: this.dataset.temp || '1' };
      this.querySelectorAll('[data-q]').forEach((btn) => {
        btn.addEventListener('click', () => { this.state[btn.dataset.q] = btn.dataset.v; this.update(); });
      });
      this.update();
    }
    update() {
      const { act, temp } = this.state;
      this.querySelectorAll('[data-q]').forEach((btn) => {
        btn.setAttribute('aria-pressed', this.state[btn.dataset.q] === btn.dataset.v ? 'true' : 'false');
      });
      const recs = Array.from(this.querySelectorAll('.wp-finder__rec'));
      const score = (r) => {
        const a = r.dataset.act, t = r.dataset.temp;
        if ((a !== 'any' && a !== act) || (t !== 'any' && t !== temp)) return -1;
        return (a === act ? 2 : 0) + (t === temp ? 1 : 0);
      };
      let best = null, bestScore = -1;
      recs.forEach((r) => { const s = score(r); if (s > bestScore) { best = r; bestScore = s; } });
      if (!best) best = recs[0];
      recs.forEach((r) => { r.hidden = r !== best; });
    }
  });
}
{% endjavascript %}

