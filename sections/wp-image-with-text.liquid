<div class="wp wp-iwt wp--case-{{ section.settings.style_heading_case }} wp--align-{{ section.settings.style_align }} wp--width-{{ section.settings.style_width }} wp--size-{{ section.settings.style_heading_size }} wp--btn-{{ section.settings.style_button_look }} wp--btn-{{ section.settings.style_button_shape }} wp--btn-{{ section.settings.style_button_size }} wp--btn-case-{{ section.settings.style_button_case }}" id="wp-{{ section.id }}" style="--wp-section-bg: {{ section.settings.background_color }}; --wp-pt: {{ section.settings.padding_top }}px; --wp-pb: {{ section.settings.padding_bottom }}px; --wp-radius: {{ section.settings.style_radius }}px;{%- if section.settings.style_heading_color != blank %} --wp-heading-user: {{ section.settings.style_heading_color }};{%- endif -%}{%- if section.settings.style_text_color != blank %} --wp-text: {{ section.settings.style_text_color }}; --wp-text-user: {{ section.settings.style_text_color }};{%- endif -%}{%- if section.settings.style_accent_color != blank %} --wp-cta: {{ section.settings.style_accent_color }};{%- endif -%}{%- if section.settings.style_button_text_color != blank %} --wp-cta-text: {{ section.settings.style_button_text_color }};{%- endif -%}{%- if section.settings.style_card_color != blank %} --wp-card: {{ section.settings.style_card_color }}; --wp-card-user: {{ section.settings.style_card_color }};{%- endif -%}">
  <div class="wp__inner wp__inner--wide">
    <div class="wp-iwt__card wp-iwt--{{ section.settings.image_position }}" style="--wp-iwt-bg: {{ section.settings.card_color }}; --wp-iwt-fg: {{ section.settings.text_color }};">
      <div class="wp-iwt__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 55vw, 100vw', widths: '600, 900, 1200, 1600', alt: section.settings.image.alt }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="wp-iwt__body">
        {%- if section.settings.eyebrow != blank -%}<span class="wp-eyebrow" style="color: {{ section.settings.eyebrow_color }}">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="wp-h2 wp-h2--lg" style="--wp-heading: var(--wp-iwt-fg)">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="wp-rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}<a class="wp-btn wp-btn--{{ section.settings.button_style }}" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.wp-iwt__card { display: flex; flex-wrap: wrap; overflow: hidden; border-radius: var(--wp-radius); background: var(--wp-iwt-bg, #414A44); color: var(--wp-iwt-fg, #F0F4F6); }
.wp-iwt--right { flex-direction: row-reverse; }
.wp-iwt__media { position: relative; flex: 1 1 560px; min-height: 480px; background: rgba(0,0,0,0.12); }
.wp-iwt__media img, .wp-iwt__media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.wp-iwt__body { flex: 1 1 420px; padding: 64px 56px; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 18px; }
.wp-iwt__body .wp-rte { font-size: 16px; max-width: 480px; }
.wp-iwt__body .wp-btn { margin-top: 8px; }
.wp-iwt__body .wp-h2 { --wp-heading: var(--wp-iwt-fg); }
@media (max-width: 749px) { .wp-iwt__media { min-height: 300px; } .wp-iwt__body { padding: 32px 20px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "WP Image with text",
  "class": "wp-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card color",
      "default": "{{ settings.color_palette.color2 }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Made in Östersund, Sweden"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "{{ settings.color_palette.color7 }}"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Where winter is a way of life"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We knit our own Ullfrotté fabric: fine merino blended with polyamide so it lasts, with terry loops inside that trap warm air against your skin.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "outline-light",
          "label": "Outline, light"
        },
        {
          "value": "outline",
          "label": "Outline, dark"
        },
        {
          "value": "primary",
          "label": "Autumn red"
        },
        {
          "value": "light",
          "label": "White"
        }
      ],
      "default": "outline-light"
    },
    {
      "type": "header",
      "content": "Look"
    },
    {
      "type": "paragraph",
      "content": "Leave a color empty to use the Woolpower default."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "style_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "style_text_color",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "style_accent_color",
      "label": "Button and accent color"
    },
    {
      "type": "color",
      "id": "style_button_text_color",
      "label": "Button text color"
    },
    {
      "type": "color",
      "id": "style_card_color",
      "label": "Card and tile color"
    },
    {
      "type": "select",
      "id": "style_heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xlarge",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "style_heading_case",
      "label": "Heading letters",
      "options": [
        {
          "value": "upper",
          "label": "ALL CAPS"
        },
        {
          "value": "normal",
          "label": "Normal"
        }
      ],
      "default": "upper"
    },
    {
      "type": "select",
      "id": "style_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "style_radius",
      "label": "Corner rounding",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "style_width",
      "label": "Width",
      "options": [
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "contained"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "select",
      "id": "style_button_look",
      "label": "Button style",
      "options": [
        {
          "value": "default",
          "label": "As set on each button"
        },
        {
          "value": "filled",
          "label": "Filled with accent color"
        },
        {
          "value": "outline",
          "label": "Outline in accent color"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "style_button_shape",
      "label": "Button shape",
      "options": [
        {
          "value": "pill",
          "label": "Pill"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "pill"
    },
    {
      "type": "select",
      "id": "style_button_size",
      "label": "Button size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "style_button_case",
      "label": "Button letters",
      "options": [
        {
          "value": "upper",
          "label": "ALL CAPS"
        },
        {
          "value": "normal",
          "label": "Normal"
        }
      ],
      "default": "upper"
    },
    {
      "type": "header",
      "content": "Spacing"
