<div class="wp wp-pills wp--case-{{ section.settings.style_heading_case }} wp--align-{{ section.settings.style_align }} wp--width-{{ section.settings.style_width }} wp--size-{{ section.settings.style_heading_size }} wp--btn-{{ section.settings.style_button_look }} wp--btn-{{ section.settings.style_button_shape }} wp--btn-{{ section.settings.style_button_size }} wp--btn-case-{{ section.settings.style_button_case }}" id="wp-{{ section.id }}" style="--wp-section-bg: {{ section.settings.background_color }}; --wp-pt: {{ section.settings.padding_top }}px; --wp-pb: {{ section.settings.padding_bottom }}px; --wp-radius: {{ section.settings.style_radius }}px;{%- if section.settings.style_heading_color != blank %} --wp-heading-user: {{ section.settings.style_heading_color }};{%- endif -%}{%- if section.settings.style_text_color != blank %} --wp-text: {{ section.settings.style_text_color }}; --wp-text-user: {{ section.settings.style_text_color }};{%- endif -%}{%- if section.settings.style_accent_color != blank %} --wp-cta: {{ section.settings.style_accent_color }};{%- endif -%}{%- if section.settings.style_button_text_color != blank %} --wp-cta-text: {{ section.settings.style_button_text_color }};{%- endif -%}{%- if section.settings.style_card_color != blank %} --wp-card: {{ section.settings.style_card_color }}; --wp-card-user: {{ section.settings.style_card_color }};{%- endif -%}">
  <div class="wp__inner">
    <nav class="wp-pills__row" aria-label="{{ section.settings.label | escape }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image
          if img == blank and c != blank
            assign img = c.featured_image
          endif
          assign label = block.settings.label | default: c.title
          assign url = block.settings.link | default: c.url
          assign active = false
          if collection and c != blank and c.handle == collection.handle
            assign active = true
          endif
        -%}
        <a class="wp-pills__pill{% if active %} is-active{% endif %}" href="{{ url | default: '#' }}" {% if active %}aria-current="page"{% endif %} {{ block.shopify_attributes }}>
          {%- if section.settings.show_images -%}
            <span class="wp-pills__img">
              {%- if img != blank -%}{{ img | image_url: width: 96, height: 96, crop: 'top' | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
            </span>
          {%- endif -%}
          <span>{{ label | default: 'Category' }}</span>
        </a>
      {%- endfor -%}
    </nav>
  </div>
</div>

{% stylesheet %}
.wp-pills__row { display: flex; gap: 12px; flex-wrap: wrap; }
@media (max-width: 749px) { .wp-pills__row { flex-wrap: nowrap; overflow-x: auto; margin-inline: -16px; padding: 2px 16px; scrollbar-width: none; } }
.wp-pills__pill { flex: none; display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 4px 18px 4px 4px; border-radius: 999px; background: var(--wp-card); color: var(--wp-ink); text-decoration: none; font-size: 14px; font-weight: 700; }
.wp-pills__pill:not(:has(.wp-pills__img)) { padding-left: 18px; }
.wp-pills__pill:hover { box-shadow: inset 0 0 0 1px var(--wp-ink); }
.wp-pills__pill.is-active { background: var(--wp-ink); color: #FFFFFF; }
.wp-pills__img { width: 40px; height: 40px; border-radius: 999px; overflow: hidden; background: var(--wp-bg); flex: none; }
.wp-pills__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
{% endstylesheet %}

{% schema %}
{
  "name": "WP Category pills",
  "class": "wp-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Menu name for screen readers",
      "default": "Categories"
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show images",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "The pill for the collection being viewed is highlighted."
    },
    {
      "type": "header",
      "content": "Look"
    },
    {
      "type": "paragraph",
      "content": "Leave a color empty to use the Woolpower default."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "style_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "style_text_color",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "style_accent_color",
      "label": "Button and accent color"
    },
    {
      "type": "color",
      "id": "style_button_text_color",
      "label": "Button text color"
    },
    {
      "type": "color",
      "id": "style_card_color",
      "label": "Card and tile color"
    },
    {
      "type": "select",
      "id": "style_heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xlarge",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "style_heading_case",
      "label": "Heading letters",
      "options": [
        {
          "value": "upper",
          "label": "ALL CAPS"
        },
        {
          "value": "normal",
          "label": "Normal"
        }
      ],
      "default": "upper"
    },
    {
      "type": "select",
      "id": "style_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "style_radius",
      "label": "Corner rounding",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "style_width",
      "label": "Width",
      "options": [
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "contained"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "select",
      "id": "style_button_look",
      "label": "Button style",
      "options": [
        {
          "value": "default",
          "label": "As set on each button"
        },
        {
          "value": "filled",
          "label": "Filled with accent color"
        },
        {
          "value": "outline",
          "label": "Outline in accent color"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "style_button_shape",
      "label": "Button shape",
      "options": [
        {
          "value": "pill",
          "label": "Pill"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "pill"
    },
    {
      "type": "select",
      "id": "style_button_size",
      "label": "Button size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "style_button_case",
      "label": "Button letters",
      "options": [
        {
          "value": "upper",
          "label": "ALL CAPS"
        },
        {
          "value": "normal",
          "label": "Normal"
        }
      ],
      "default": "upper"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Leave empty to use the collection name."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave empty to use the collection image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave empty to link to the collection."
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "WP Category pills",
      "blocks": [
        {
          "type": "pill"
        },
        {
          "type": "pill"
        },
        {
          "type": "pill"
        },
        {
          "type": "pill"
        }
      ]
    }
  ]
}
{% endschema %}
