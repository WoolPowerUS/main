<div class="wp wp-plp-section wp--case-{{ section.settings.style_heading_case }} wp--align-{{ section.settings.style_align }} wp--width-{{ section.settings.style_width }} wp--size-{{ section.settings.style_heading_size }} wp--btn-{{ section.settings.style_button_look }} wp--btn-{{ section.settings.style_button_shape }} wp--btn-{{ section.settings.style_button_size }} wp--btn-case-{{ section.settings.style_button_case }}" id="wp-{{ section.id }}" style="--wp-section-bg: {{ section.settings.background_color }}; --wp-pt: {{ section.settings.padding_top }}px; --wp-pb: {{ section.settings.padding_bottom }}px; --wp-radius: {{ section.settings.style_radius }}px;{%- if section.settings.style_heading_color != blank %} --wp-heading-user: {{ section.settings.style_heading_color }};{%- endif -%}{%- if section.settings.style_text_color != blank %} --wp-text: {{ section.settings.style_text_color }}; --wp-text-user: {{ section.settings.style_text_color }};{%- endif -%}{%- if section.settings.style_accent_color != blank %} --wp-cta: {{ section.settings.style_accent_color }};{%- endif -%}{%- if section.settings.style_button_text_color != blank %} --wp-cta-text: {{ section.settings.style_button_text_color }};{%- endif -%}{%- if section.settings.style_card_color != blank %} --wp-card: {{ section.settings.style_card_color }}; --wp-card-user: {{ section.settings.style_card_color }};{%- endif -%}">
  {%- paginate collection.products by section.settings.per_page -%}
  {%- liquid
    assign sort_by = collection.sort_by | default: collection.default_sort_by
    assign active_count = 0
    for filter in collection.filters
      assign active_count = active_count | plus: filter.active_values.size
      if filter.type == 'price_range'
        if filter.min_value.value != nil or filter.max_value.value != nil
          assign active_count = active_count | plus: 1
        endif
      endif
    endfor
    assign shown = paginate.current_offset | plus: collection.products.size
  -%}
  <wp-collection class="wp-plp{% if section.settings.filters_open %} is-open{% endif %}" data-section="{{ section.id }}" data-url="{{ collection.url }}">
    <form class="wp-plp__form" id="wp-ff-{{ section.id }}" data-form action="{{ collection.url }}" method="get"></form>
      <div class="wp-plp__bar">
        <div class="wp__inner wp-plp__bar-inner">
          {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
            <button type="button" class="wp-plp__toggle" data-toggle aria-controls="wp-filters-{{ section.id }}">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M7 12h10M10 18h4"></path></svg>
              <span class="wp-plp__toggle-desktop"><span data-label-open>Hide filters</span><span data-label-closed>Show filters</span></span>
              <span class="wp-plp__toggle-mobile">Filter</span>
              {%- if active_count > 0 -%}<span class="wp-plp__toggle-count">{{ active_count }}</span>{%- endif -%}
            </button>
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}
                <a class="wp-plp__chip" href="{{ value.url_to_remove }}" data-ajax-link aria-label="Remove filter {{ filter.label | escape }}: {{ value.label | escape }}">{{ filter.label }}: {{ value.label }}<span aria-hidden="true">×</span></a>
              {%- endfor -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                  <a class="wp-plp__chip" href="{{ filter.url_to_remove }}" data-ajax-link>{{ filter.min_value.value | default: 0 | money_without_trailing_zeros }}–{% if filter.max_value.value %}{{ filter.max_value.value | money_without_trailing_zeros }}{% else %}{{ filter.range_max | money_without_trailing_zeros }}{% endif %}<span aria-hidden="true">×</span></a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if active_count > 0 -%}
              <a class="wp-plp__clear" href="{{ collection.url }}?sort_by={{ sort_by }}" data-ajax-link>Clear all</a>
            {%- endif -%}
          {%- endif -%}
          <span class="wp-plp__count">{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</span>
          {%- if section.settings.enable_sorting -%}
            <label class="wp-plp__sort">
              <span>Sort</span>
              <select name="sort_by" form="wp-ff-{{ section.id }}" data-sort>
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
            </label>
          {%- endif -%}
        </div>
      </div>

      <div class="wp__inner wp-plp__body">
        {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
          <aside class="wp-plp__filters" id="wp-filters-{{ section.id }}" aria-label="Filters">
            <div class="wp-plp__filters-head">
              <strong>Filter</strong>
              <button type="button" class="wp-plp__close" data-close aria-label="Close filters">×</button>
            </div>
            {%- for filter in collection.filters -%}
              {%- liquid
                assign flabel = filter.label | downcase
                assign kind = 'list'
                if filter.type == 'price_range'
                  assign kind = 'price'
                elsif filter.presentation == 'swatch' or flabel contains 'color' or flabel contains 'colour' or flabel contains 'färg'
                  assign kind = 'color'
                elsif flabel contains 'size' or flabel contains 'storlek'
                  assign kind = 'size'
                elsif flabel contains 'weight' or flabel contains 'vikt'
                  assign kind = 'weight'
                endif
                assign open = false
                if forloop.index <= section.settings.open_filters
                  assign open = true
                endif
                if filter.active_values.size > 0
                  assign open = true
                endif
              -%}
              <details class="wp-plp__group" {% if open %}open{% endif %}>
                <summary>{{ filter.label }}{% if filter.active_values.size > 0 %} <span class="wp-plp__group-count">({{ filter.active_values.size }})</span>{% endif %}<span aria-hidden="true" class="wp-faq__icon"></span></summary>
                {%- case kind -%}
                  {%- when 'price' -%}
                    <div class="wp-plp__price">
                      <label><span>From</span><input type="number" form="wp-ff-{{ section.id }}" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | remove: ',' }}" placeholder="0" min="0" inputmode="decimal"></label>
                      <label><span>To</span><input type="number" form="wp-ff-{{ section.id }}" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | remove: ',' }}" placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}" min="0" inputmode="decimal"></label>
                    </div>
                  {%- when 'size' -%}
                    <div class="wp-plp__sizes">
                      {%- for value in filter.values -%}
                        <label class="wp-plp__size{% if value.count == 0 and value.active == false %} is-empty{% endif %}">
                          <input type="checkbox" form="wp-ff-{{ section.id }}" class="wp-visually-hidden" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                          <span>{{ value.label }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  {%- when 'color' -%}
                    <div class="wp-plp__colors">
                      {%- for value in filter.values -%}
                        {%- capture hex -%}{% render 'wp-color-hex', value: value.label, swatch: value.swatch %}{%- endcapture -%}
                        <label class="wp-plp__color{% if value.count == 0 and value.active == false %} is-empty{% endif %}">
                          <input type="checkbox" form="wp-ff-{{ section.id }}" class="wp-visually-hidden" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                          <span class="wp-plp__dot" style="background: {{ hex | strip }}"></span>
                          <span>{{ value.label }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <div class="wp-plp__list">
                      {%- for value in filter.values -%}
                        {%- liquid
                          assign vdesc = ''
                          assign vu = value.label | upcase | strip
                          if kind == 'weight' or vu == 'LITE' or vu == '200' or vu == '400' or vu == '600' or vu == '800'
                            case vu
                              when 'LITE'
                                assign vdesc = 'Thinnest. For hard effort'
                              when '200'
                                assign vdesc = 'Everyday base layer'
                              when '400'
                                assign vdesc = 'Mid layer warmth'
                              when '600'
                                assign vdesc = 'Warm, for low activity'
                              when '800'
                                assign vdesc = 'Warmest. Standing still'
                            endcase
                          endif
                        -%}
                        <label class="wp-plp__check{% if value.count == 0 and value.active == false %} is-empty{% endif %}">
                          <input type="checkbox" form="wp-ff-{{ section.id }}" class="wp-visually-hidden" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                          <span class="wp-plp__box" aria-hidden="true"></span>
                          <span class="wp-plp__check-text"><strong>{{ value.label }} <span>({{ value.count }})</span></strong>{%- if vdesc != '' -%}<span>{{ vdesc }}</span>{%- endif -%}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                {%- endcase -%}
              </details>
            {%- endfor -%}
            <div class="wp-plp__filters-foot">
              <a class="wp-btn wp-btn--outline" href="{{ collection.url }}?sort_by={{ sort_by }}" data-ajax-link>Clear</a>
              <button type="button" class="wp-btn wp-btn--primary" data-close>Show {{ collection.products_count }}</button>
            </div>
            <noscript><button type="submit" form="wp-ff-{{ section.id }}" class="wp-btn wp-btn--primary">Apply</button></noscript>
          </aside>
        {%- endif -%}

        <div class="wp-plp__results">
          {%- if collection.products.size > 0 -%}
            <div class="wp-grid wp-plp__grid" data-grid style="--wp-cols: {{ section.settings.columns }}; --wp-cols-mobile: {{ section.settings.columns_mobile }};">
              {%- assign promo_at = -1 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'promo' -%}{%- assign promo_at = block.settings.position | minus: 1 -%}{%- endif -%}
              {%- endfor -%}
              {%- for product in collection.products -%}
                {%- liquid
                  if forloop.first and paginate.current_page == 1
                    assign img_loading = 'eager'
                  else
                    assign img_loading = 'lazy'
                  endif
                -%}
                {%- if paginate.current_page == 1 and forloop.index0 == promo_at -%}
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'promo' -%}
                      <a class="wp-plp__promo" href="{{ block.settings.link | default: '#' }}" style="--promo-bg: {{ block.settings.color }};" {{ block.shopify_attributes }}>
                        {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'wp-plp__promo-img', alt: '' }}{%- endif -%}
                        <span class="wp-plp__promo-body">
                          {%- if block.settings.eyebrow != blank -%}<span class="wp-eyebrow" style="color: var(--wp-yellow)">{{ block.settings.eyebrow }}</span>{%- endif -%}
                          <strong>{{ block.settings.heading }}</strong>
                          {%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}
                          {%- if block.settings.button_label != blank -%}<span class="wp-btn wp-btn--light">{{ block.settings.button_label }}</span>{%- endif -%}
                        </span>
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                {% render 'wp-product-card', product: product, quick_add: section.settings.quick_add, image_loading: img_loading %}
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="wp-plp__empty">
              <strong>No products match these filters</strong>
              <a class="wp-btn wp-btn--primary" href="{{ collection.url }}" data-ajax-link>Clear filters</a>
            </div>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            <div class="wp-plp__more" data-more>
              <span data-shown-label>Showing {{ shown }} of {{ paginate.items }}</span>
              <span class="wp-plp__progress"><span style="width: {{ shown | times: 100 | divided_by: paginate.items }}%" data-progress></span></span>
              {%- if paginate.next -%}
                <a class="wp-btn wp-btn--outline" href="{{ paginate.next.url }}" data-load-more data-total="{{ paginate.items }}">{{ section.settings.load_more_label }}</a>
              {%- endif -%}
              {%- if paginate.previous -%}
                <a class="wp-link" href="{{ paginate.previous.url }}">Previous page</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    <div class="wp-plp__scrim" data-close></div>
  </wp-collection>
  {%- endpaginate -%}
</div>

{% stylesheet %}
.wp-plp__bar { position: sticky; top: var(--header-height, 0px); z-index: 4; background: var(--wp-section-bg, var(--wp-bg)); border-block: 1px solid var(--wp-line-soft); }
.wp-plp__bar-inner { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; padding-block: 12px; }
.wp-plp__toggle { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 18px; border-radius: 999px; border: 1px solid var(--wp-ink); background: var(--wp-card); color: var(--wp-ink); font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; }
.wp-plp__toggle-count { min-width: 20px; height: 20px; padding: 0 6px; border-radius: 999px; background: var(--wp-ink); color: #FFFFFF; font-size: 11px; display: inline-flex; align-items: center; justify-content: center; }
.wp-plp__toggle-mobile, .wp-plp.is-open [data-label-closed], .wp-plp:not(.is-open) [data-label-open] { display: none; }
.wp-plp__chip { display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 14px; border-radius: 999px; background: var(--wp-ink); color: #FFFFFF; font-size: 13px; font-weight: 700; text-decoration: none; }
.wp-plp__chip:hover { background: var(--wp-cta); color: var(--wp-cta-text, #FFFFFF); }
.wp-plp__clear { padding: 0 4px; font-size: 13px; font-weight: 700; color: var(--wp-cta); }
.wp-plp__count { margin-left: auto; font-size: 13px; }
.wp-plp__sort { display: flex; align-items: center; gap: 8px; font-size: 13px; }
.wp-plp__sort select { height: 40px; padding: 0 32px 0 14px; border-radius: 999px; border: 1px solid var(--wp-line); background: var(--wp-card); color: var(--wp-ink); font: inherit; font-size: 13px; }
.wp-plp__body { display: flex; gap: 40px; align-items: flex-start; padding-block: 28px 0; }
.wp-plp__filters { flex: 0 0 260px; position: sticky; top: calc(var(--header-height, 0px) + 80px); max-height: calc(100vh - var(--header-height, 0px) - 100px); overflow-y: auto; scrollbar-width: thin; }
.wp-plp:not(.is-open) .wp-plp__filters { display: none; }
.wp-plp__filters-head, .wp-plp__filters-foot { display: none; }
.wp-plp__results { flex: 1 1 auto; min-width: 0; transition: opacity .15s; }
.wp-plp.is-loading .wp-plp__results { opacity: 0.45; pointer-events: none; }
.wp-plp__group { border-bottom: 1px solid var(--wp-line); padding: 14px 0; }
.wp-plp__group summary { list-style: none; display: flex; align-items: center; gap: 6px; cursor: pointer; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--wp-ink); }
.wp-plp__group summary::-webkit-details-marker { display: none; }
.wp-plp__group .wp-faq__icon { position: relative; flex: none; width: 12px; height: 12px; margin-left: auto; }
.wp-plp__group .wp-faq__icon::before, .wp-plp__group .wp-faq__icon::after { content: ""; position: absolute; left: 0; top: 5px; width: 12px; height: 2px; background: currentColor; transition: transform .2s; }
.wp-plp__group .wp-faq__icon::after { transform: rotate(90deg); }
.wp-plp__group[open] .wp-faq__icon::after { transform: rotate(0deg); }
.wp-plp__group-count { font-weight: 400; color: var(--wp-text); }
.wp-plp__list { display: flex; flex-direction: column; gap: 4px; margin-top: 12px; }
.wp-plp__check { display: flex; gap: 12px; align-items: center; padding: 8px; margin-inline: -8px; border-radius: 8px; cursor: pointer; }
.wp-plp__check:has(input:checked) { background: var(--wp-card); }
.wp-plp__box { flex: none; width: 20px; height: 20px; border-radius: 4px; border: 1px solid #8C979B; background: #FFFFFF; display: flex; align-items: center; justify-content: center; }
.wp-plp__check input:checked + .wp-plp__box { background: var(--wp-ink); border-color: var(--wp-ink); }
.wp-plp__check input:checked + .wp-plp__box::after { content: "✓"; color: #FFFFFF; font-size: 13px; font-weight: 700; }
.wp-plp__check input:focus-visible + .wp-plp__box, .wp-plp__size input:focus-visible + span, .wp-plp__color input:focus-visible + .wp-plp__dot { outline: 2px solid var(--wp-ink); outline-offset: 2px; }
.wp-plp__check-text { display: flex; flex-direction: column; line-height: 1.3; font-size: 12px; }
.wp-plp__check-text strong { font-size: 14px; color: var(--wp-ink); }
.wp-plp__check-text strong span { font-weight: 400; color: var(--wp-text); }
.wp-plp__sizes { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; margin-top: 12px; }
.wp-plp__size span { display: flex; align-items: center; justify-content: center; height: 40px; border-radius: 8px; border: 1px solid var(--wp-line); background: var(--wp-card); font-size: 12px; font-weight: 700; color: var(--wp-ink); cursor: pointer; }
.wp-plp__size input:checked + span { background: var(--wp-ink); border-color: var(--wp-ink); color: #FFFFFF; }
.wp-plp__colors { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 12px; font-size: 13px; }
.wp-plp__color { display: flex; align-items: center; gap: 8px; cursor: pointer; }
.wp-plp__dot { flex: none; width: 20px; height: 20px; border-radius: 999px; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.12); }
.wp-plp__color input:checked + .wp-plp__dot { outline: 2px solid var(--wp-ink); outline-offset: 2px; }
.wp-plp__color input:checked ~ span:last-child { font-weight: 700; color: var(--wp-ink); }
.is-empty { opacity: 0.45; cursor: not-allowed; }
.wp-plp__price { display: flex; gap: 10px; margin-top: 12px; }
.wp-plp__price label { flex: 1; display: flex; flex-direction: column; gap: 4px; font-size: 12px; }
.wp-plp__price input { height: 40px; padding: 0 10px; border-radius: 8px; border: 1px solid var(--wp-line); background: #FFFFFF; font: inherit; color: var(--wp-ink); }
.wp-plp__grid { gap: 32px 20px; }
.wp-plp__promo { position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: 100%; aspect-ratio: auto; overflow: hidden; border-radius: var(--wp-radius); background: var(--promo-bg, #414A44); color: #F0F4F6; text-decoration: none; }
.wp-plp__promo-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.35; }
.wp-plp__promo-body { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 28px; min-height: 360px; justify-content: flex-end; }
.wp-plp__promo strong { font-size: 24px; line-height: 1.15; text-transform: uppercase; color: #FFFFFF; }
.wp-plp__promo .wp-btn { margin-top: 6px; min-height: 44px; }
.wp-plp__empty { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 40px; border-radius: var(--wp-radius); background: var(--wp-card); text-align: center; }
.wp-plp__empty strong { font-size: 18px; color: var(--wp-ink); }
.wp-plp__more { display: flex; flex-direction: column; align-items: center; gap: 12px; margin-top: 48px; font-size: 13px; }
.wp-plp__progress { width: 240px; height: 3px; border-radius: 999px; background: var(--wp-line); overflow: hidden; }
.wp-plp__progress span { display: block; height: 100%; background: var(--wp-ink); transition: width .3s; }
.wp-plp__more .wp-btn { margin-top: 8px; }
.wp-plp__scrim { display: none; }
@media (max-width: 989px) {
  .wp-plp__toggle-desktop { display: none; }
  .wp-plp__toggle-mobile { display: inline; }
  .wp-plp__count { display: none; }
  .wp-plp__sort { margin-left: auto; }
  .wp-plp__sort > span { display: none; }
  .wp-plp__body { display: block; }
  .wp-plp .wp-plp__filters, .wp-plp:not(.is-open) .wp-plp__filters { display: flex; flex-direction: column; position: fixed; inset: 0 auto 0 0; z-index: 50; width: min(88vw, 380px); max-height: none; padding: 0 20px; background: var(--wp-bg); transform: translateX(-100%); transition: transform .25s; top: 0; }
  .wp-plp.is-drawer .wp-plp__filters { transform: none; }
  .wp-plp__filters-head { display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1; padding: 16px 0; background: var(--wp-bg); border-bottom: 1px solid var(--wp-line); }
  .wp-plp__filters-head strong { font-size: 16px; text-transform: uppercase; color: var(--wp-ink); }
  .wp-plp__close { width: 44px; height: 44px; border: 0; background: transparent; font-size: 26px; color: var(--wp-ink); cursor: pointer; }
  .wp-plp__filters-foot { display: flex; gap: 10px; position: sticky; bottom: 0; margin-top: auto; padding: 16px 0; background: var(--wp-bg); border-top: 1px solid var(--wp-line); }
  .wp-plp__filters-foot .wp-btn { flex: 1; }
  .wp-plp.is-drawer .wp-plp__scrim { display: block; position: fixed; inset: 0; z-index: 49; background: rgba(31,45,64,0.45); }
}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('wp-collection')) {
  customElements.define('wp-collection', class extends HTMLElement {
    connectedCallback() {
      this.mq = window.matchMedia('(max-width: 989px)');
      this.addEventListener('click', (e) => this.onClick(e));
      this.addEventListener('change', (e) => {
        if (e.target.form && e.target.form.matches('[data-form]')) { window.clearTimeout(this._t); this._t = window.setTimeout(() => this.apply(), e.target.type === 'number' ? 600 : 0); }
      });
      this.addEventListener('submit', (e) => { e.preventDefault(); this.apply(); });
      window.addEventListener('popstate', () => this.load(window.location.href, false));
    }
    onClick(e) {
      const t = e.target;
      if (t.closest('[data-toggle]')) {
        if (this.mq.matches) this.setDrawer(true); else this.classList.toggle('is-open');
        return;
      }
      if (t.closest('[data-close]')) { this.setDrawer(false); return; }
      const ajax = t.closest('[data-ajax-link]');
      if (ajax) { e.preventDefault(); this.load(ajax.href, true); return; }
      const more = t.closest('[data-load-more]');
      if (more) { e.preventDefault(); this.loadMore(more); }
    }
    setDrawer(open) {
      this.classList.toggle('is-drawer', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
    }
    apply() {
      const form = this.querySelector('[data-form]');
      const params = new URLSearchParams();
      new FormData(form).forEach((v, k) => { if (v !== '') params.append(k, v); });
      this.load(this.dataset.url + '?' + params.toString(), true);
    }
    async fetchSection(url) {
      const u = new URL(url, window.location.origin);
      u.searchParams.set('section_id', this.dataset.section);
      const html = await (await fetch(u.toString())).text();
      return new DOMParser().parseFromString(html, 'text/html').querySelector('wp-collection');
    }
    async load(url, push) {
      this.classList.add('is-loading');
      try {
        const fresh = await this.fetchSection(url);
        if (!fresh) { window.location.href = url; return; }
        const openGroups = Array.from(this.querySelectorAll('.wp-plp__group')).map((d) => d.open);
        const scroll = this.querySelector('.wp-plp__filters') ? this.querySelector('.wp-plp__filters').scrollTop : 0;
        this.innerHTML = fresh.innerHTML;
        this.querySelectorAll('.wp-plp__group').forEach((d, i) => { if (openGroups[i] !== undefined) d.open = openGroups[i] || d.open; });
        const f = this.querySelector('.wp-plp__filters'); if (f) f.scrollTop = scroll;
        if (push) window.history.pushState({}, '', url);
      } catch (err) { window.location.href = url; }
      finally { this.classList.remove('is-loading'); }
    }
    async loadMore(link) {
      link.setAttribute('aria-busy', 'true');
      try {
        const fresh = await this.fetchSection(link.href);
        const grid = this.querySelector('[data-grid]');
        fresh.querySelectorAll('[data-grid] > *').forEach((card) => grid.appendChild(card));
        const total = Number(link.dataset.total) || 0;
        const shown = grid.querySelectorAll('.wp-card').length;
        const label = this.querySelector('[data-shown-label]'); if (label) label.textContent = 'Showing ' + shown + ' of ' + total;
        const bar = this.querySelector('[data-progress]'); if (bar && total) bar.style.width = Math.round(shown / total * 100) + '%';
        const next = fresh.querySelector('[data-load-more]');
        if (next) { link.href = next.href; link.removeAttribute('aria-busy'); } else { link.remove(); }
      } catch (err) { window.location.href = link.href; }
    }
  });
}
{% endjavascript %}

