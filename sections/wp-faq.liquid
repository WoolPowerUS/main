<div class="wp wp-faq wp--case-{{ section.settings.style_heading_case }} wp--align-{{ section.settings.style_align }} wp--width-{{ section.settings.style_width }} wp--size-{{ section.settings.style_heading_size }} wp--btn-{{ section.settings.style_button_look }} wp--btn-{{ section.settings.style_button_shape }} wp--btn-{{ section.settings.style_button_size }} wp--btn-case-{{ section.settings.style_button_case }}" id="wp-{{ section.id }}" style="--wp-section-bg: {{ section.settings.background_color }}; --wp-pt: {{ section.settings.padding_top }}px; --wp-pb: {{ section.settings.padding_bottom }}px; --wp-radius: {{ section.settings.style_radius }}px;{%- if section.settings.style_heading_color != blank %} --wp-heading-user: {{ section.settings.style_heading_color }};{%- endif -%}{%- if section.settings.style_text_color != blank %} --wp-text: {{ section.settings.style_text_color }}; --wp-text-user: {{ section.settings.style_text_color }};{%- endif -%}{%- if section.settings.style_accent_color != blank %} --wp-cta: {{ section.settings.style_accent_color }};{%- endif -%}{%- if section.settings.style_button_text_color != blank %} --wp-cta-text: {{ section.settings.style_button_text_color }};{%- endif -%}{%- if section.settings.style_card_color != blank %} --wp-card: {{ section.settings.style_card_color }}; --wp-card-user: {{ section.settings.style_card_color }};{%- endif -%}">
  <div class="wp__inner wp-faq__wrap">
    <div class="wp-faq__intro">
      {%- if section.settings.heading != blank -%}<h2 class="wp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="wp-rte" style="margin-top: 12px">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="wp-faq__list">
      {%- for block in section.blocks -%}
        <details class="wp-faq__item" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span aria-hidden="true" class="wp-faq__icon"></span></summary>
          <div class="wp-rte wp-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.settings.schema_markup and section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</div>

{% stylesheet %}
.wp-faq__wrap { display: flex; gap: 48px; flex-wrap: wrap; }
.wp-faq__intro { flex: 1 1 360px; }
.wp-faq__list { flex: 1 1 480px; }
.wp-faq__item { border-bottom: 1px solid var(--wp-line); }
.wp-faq__item summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 56px; padding: 12px 0; cursor: pointer; font-weight: 700; color: var(--wp-ink); }
.wp-faq__item summary::-webkit-details-marker { display: none; }
.wp-faq__icon { position: relative; flex: none; width: 14px; height: 14px; }
.wp-faq__icon::before, .wp-faq__icon::after { content: ""; position: absolute; left: 0; top: 6px; width: 14px; height: 2px; background: currentColor; transition: transform .2s; }
.wp-faq__icon::after { transform: rotate(90deg); }
.wp-faq__item[open] .wp-faq__icon::after { transform: rotate(0deg); }
.wp-faq__answer { padding-bottom: 18px; font-size: 14px; }
{% endstylesheet %}

{% schema %}
{
  "name": "WP FAQ",
  "class": "wp-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Questions"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "schema_markup",
      "label": "Add FAQ data for Google",
      "default": true
    },
    {
      "type": "header",
      "content": "Look"
    },
    {
      "type": "paragraph",
      "content": "Leave a color empty to use the Woolpower default."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "style_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "style_text_color",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "style_accent_color",
      "label": "Button and accent color"
    },
    {
      "type": "color",
      "id": "style_button_text_color",
      "label": "Button text color"
    },
    {
      "type": "color",
      "id": "style_card_color",
      "label": "Card and tile color"
    },
    {
      "type": "select",
      "id": "style_heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xlarge",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "style_heading_case",
      "label": "Heading letters",
      "options": [
        {
          "value": "upper",
          "label": "ALL CAPS"
        },
        {
          "value": "normal",
          "label": "Normal"
        }
      ],
      "default": "upper"
    },
    {
      "type": "select",
      "id": "style_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "style_radius",
      "label": "Corner rounding",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "style_width",
      "label": "Width",
      "options": [
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "contained"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "select",
      "id": "style_button_look",
      "label": "Button style",
      "options": [
        {
          "value": "default",
          "label": "As set on each button"
        },
        {
          "value": "filled",
          "label": "Filled with accent color"
        },
        {
          "value": "outline",
          "label": "Outline in accent color"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "style_button_shape",
      "label": "Button shape",
      "options": [
        {
          "value": "pill",
          "label": "Pill"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "pill"
    },
    {
      "type": "select",
      "id": "style_button_size",
      "label": "Button size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "style_button_case",
      "label": "Button letters",
      "options": [
        {
          "value": "upper",
          "label": "ALL CAPS"
        },
        {
          "value": "normal",
          "label": "Normal"
        }
      ],
      "default": "upper"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer</p>"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "WP FAQ",
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
