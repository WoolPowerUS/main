      "id": "text",
      "label": "Text",
      "default": "Build the system around it."
    },
    {
      "type": "text",
      "id": "current_prefix",
      "label": "Label before the product being viewed",
      "default": "This one:"
    },
    {
      "type": "header",
      "content": "Look"
    },
    {
      "type": "paragraph",
      "content": "Leave a color empty to use the Woolpower default."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "style_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "style_text_color",
