<div class="wp wp-tiles wp--case-{{ section.settings.style_heading_case }} wp--align-{{ section.settings.style_align }} wp--width-{{ section.settings.style_width }} wp--size-{{ section.settings.style_heading_size }} wp--btn-{{ section.settings.style_button_look }} wp--btn-{{ section.settings.style_button_shape }} wp--btn-{{ section.settings.style_button_size }} wp--btn-case-{{ section.settings.style_button_case }}" id="wp-{{ section.id }}" style="--wp-section-bg: {{ section.settings.background_color }}; --wp-pt: {{ section.settings.padding_top }}px; --wp-pb: {{ section.settings.padding_bottom }}px; --wp-radius: {{ section.settings.style_radius }}px;{%- if section.settings.style_heading_color != blank %} --wp-heading-user: {{ section.settings.style_heading_color }};{%- endif -%}{%- if section.settings.style_text_color != blank %} --wp-text: {{ section.settings.style_text_color }}; --wp-text-user: {{ section.settings.style_text_color }};{%- endif -%}{%- if section.settings.style_accent_color != blank %} --wp-cta: {{ section.settings.style_accent_color }};{%- endif -%}{%- if section.settings.style_button_text_color != blank %} --wp-cta-text: {{ section.settings.style_button_text_color }};{%- endif -%}{%- if section.settings.style_card_color != blank %} --wp-card: {{ section.settings.style_card_color }}; --wp-card-user: {{ section.settings.style_card_color }};{%- endif -%}">
  <div class="wp__inner">
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="wp-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="wp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="wp-h2{% if section.settings.eyebrow != blank %} wp-h2--lg{% endif %}" style="margin-top: 8px">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
        <a class="wp-link" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
    <div class="wp-tiles__grid" style="--wp-cols: {{ section.settings.columns }}; --wp-cols-mobile: {{ section.settings.columns_mobile }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image
          if img == blank and c != blank
            assign img = c.featured_image
          endif
          assign label = block.settings.label | default: c.title
          assign url = block.settings.link | default: c.url
        -%}
        <a class="wp-tiles__item" href="{{ url | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="wp-media wp-tiles__media wp-tiles__media--{{ section.settings.aspect }}">
            {%- if img != blank -%}
              {{ img | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 16vw, 50vw', widths: '300, 500, 700', alt: '' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </span>
          <span class="wp-tiles__label">{{ label | default: 'Category' }}<span aria-hidden="true">→</span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.wp-tiles__grid { display: grid; gap: 16px; grid-template-columns: repeat(var(--wp-cols, 6), minmax(0, 1fr)); }
@media (max-width: 989px) { .wp-tiles__grid { grid-template-columns: repeat(min(var(--wp-cols, 6), 3), minmax(0, 1fr)); } }
@media (max-width: 749px) { .wp-tiles__grid { grid-template-columns: repeat(var(--wp-cols-mobile, 2), minmax(0, 1fr)); gap: 12px; } }
.wp-tiles__item { display: flex; flex-direction: column; gap: 10px; color: var(--wp-ink); text-decoration: none; }
.wp-tiles__media--square { aspect-ratio: 1 / 1; }
.wp-tiles__media--portrait { aspect-ratio: 4 / 5; }
.wp-tiles__media img { object-position: top; transition: transform .3s; }
.wp-tiles__item:hover img { transform: scale(1.03); }
.wp-tiles__label { display: flex; justify-content: space-between; gap: 8px; font-size: 14px; font-weight: 700; }
.wp-tiles__item:hover .wp-tiles__label { color: var(--wp-cta); }
{% endstylesheet %}

